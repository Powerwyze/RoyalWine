{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": "public",
  "installCommand": "npm ci --ignore-scripts",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/banana.js": {
      "maxDuration": 300
    },
    "api/send-photo.js": {
      "maxDuration": 30
    },
    "api/host-session.js": {
      "maxDuration": 30
    },
    "api/host-greeting.js": {
      "maxDuration": 15
    }
  }
}
